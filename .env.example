# commandcode-proxy configuration. Copy to `.env`. None of these are required.

# TCP listen port.
PORT=3100

# Upstream CommandCode base URL.
COMMAND_CODE_API_URL=https://api.commandcode.ai

# If set, used as default Bearer token when callers do not send Authorization.
# Useful when the proxy holds the secret and clients are anonymous.
# COMMAND_CODE_TOKEN=user_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sent as X-Command-Code-Version when the caller doesn't provide one.
COMMAND_CODE_VERSION=0.18.10

# SQLite database file (auto-created).
ANALYTICS_DB_PATH=./data/analytics.db

# Comma-separated CORS origins, or * for any.
CORS_ORIGINS=*

# If set, gates /analytics* and /dashboard.
# ADMIN_TOKEN=change-me-please

# Comma-separated models exposed by GET /v1/models (OpenAI-shaped).
OPENAI_MODELS=moonshotai/Kimi-K2.5,moonshotai/Kimi-K2.6,deepseek/deepseek-v4-pro,Qwen/Qwen3.6-Plus,gpt-5.5,gpt-5.3-codex,claude-sonnet-4-6,claude-opus-4-7,claude-opus-4-6,zai-org/GLM-5.1,zai-org/GLM-5
